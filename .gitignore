# --- setuptools build output ---------------------------------------------
# `uv build` writes here. Un-ignoring them means the next `git add -A` sweeps in a wheel and a
# second copy of desk/.
build/
dist/
*.spec

# --- python -------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# --- reviewer and agent scratch -----------------------------------------
# Anything a helper process writes belongs to a name git already refuses: a blanket `git add -A`
# otherwise commits it.
archive/
tmpwork/
scratch/
.probe/
shots/
.trash/
probe*.db

# --- THE DATA ------------------------------------------------------------
# This repo carries the tool and its schema (desk/schema.sql), never anyone's record, which lives
# under the data root (see desk/config.py). The rule is by extension, not by path: a database
# created anywhere in the tree, under any name, is not committable, and every test builds its own
# in a temp directory.
*.db
*.db-journal
*.db-wal
*.db-shm

# Research notes and chart images belong wherever their author writes them, not in a tool repo.
theses/

# Broker statements, in any form: a PDF dropped in the tree to be read from should not become a
# committed file.
*.pdf
statements/

# --- obsidian -----------------------------------------------------------
# Per-machine UI state, not content.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.DS_Store
